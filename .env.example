# Required: your model API key
FAIRRIDE_API_KEY=sk-your-key-here

# Optional: override base URL for TokenHub or other OpenAI-compatible endpoints
# FAIRRIDE_BASE_URL=https://api.openai.com/v1

# Optional: model name (default: gpt-4o-mini)
# FAIRRIDE_MODEL=gpt-4o-mini

# Optional: stronger model for the Judge role
# FAIRRIDE_JUDGE_MODEL=gpt-4o

# Development only: set to 1 to use hand-written examples instead of live API calls
# FAIRRIDE_STUB=1
