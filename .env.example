# Required for live model calls; no default model is selected.
FAIRRIDE_API_KEY=your-api-key
FAIRRIDE_MODEL=your-provider-model-name

# Experimental extra model support checks; off for the default demo.
FAIRRIDE_CHECK_ARGUMENT_SUPPORT=0

# Optional OpenAI-compatible endpoint; default is https://api.openai.com/v1.
# FAIRRIDE_BASE_URL=https://your-provider.example/v1

# Paid live tests are opt-in; examples are selected explicitly in the UI/backend.
# FAIRRIDE_RUN_LIVE_TESTS=1
